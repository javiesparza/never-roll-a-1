rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function activeUser() {
      return request.auth != null
        && !exists(/databases/$(database)/documents/blockedUsers/$(request.auth.uid));
    }

    function validName(name) {
      return name is string
        && name.matches('[a-zA-Z0-9][a-zA-Z0-9 ]{1,18}[a-zA-Z0-9]');
    }

    function validScore(data) {
      return data.userId == request.auth.uid
        && validName(data.displayName)
        && data.streak is int && data.streak >= 1 && data.streak <= 9007199254740991
        && data.attempts is int && data.attempts >= data.streak && data.attempts <= 9007199254740991
        && data.timestamp == request.time
        && data.displayName == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.displayName;
    }

    function betterScore() {
      return request.resource.data.streak > resource.data.streak
        || (request.resource.data.streak == resource.data.streak
          && request.resource.data.attempts < resource.data.attempts);
    }

    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update: if activeUser() && request.auth.uid == userId
        && request.resource.data.keys().hasAll(['displayName', 'createdAt'])
        && request.resource.data.keys().hasOnly(['displayName', 'createdAt'])
        && validName(request.resource.data.displayName)
        && request.resource.data.createdAt == request.time;
    }

    match /dailyScores/{docId} {
      function validDailyScore() {
        let data = request.resource.data;
        return data.keys().hasAll(['userId', 'displayName', 'streak', 'attempts', 'timestamp', 'date'])
          && data.keys().hasOnly(['userId', 'displayName', 'streak', 'attempts', 'timestamp', 'date'])
          && validScore(data)
          && data.date is string && data.date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
          && docId == request.auth.uid + '_' + data.date;
      }
      allow read: if true;
      allow create: if activeUser() && validDailyScore();
      allow update: if activeUser() && validDailyScore()
        && resource.data.userId == request.auth.uid
        && request.resource.data.date == resource.data.date
        && betterScore();
    }

    match /allTimeScores/{userId} {
      function validAllTimeScore() {
        let data = request.resource.data;
        return data.keys().hasAll(['userId', 'displayName', 'streak', 'attempts', 'timestamp'])
          && data.keys().hasOnly(['userId', 'displayName', 'streak', 'attempts', 'timestamp'])
          && validScore(data);
      }
      allow read: if true;
      allow create: if activeUser() && request.auth.uid == userId && validAllTimeScore();
      allow update: if activeUser() && request.auth.uid == userId && validAllTimeScore()
        && resource.data.userId == request.auth.uid && betterScore();
    }

    // Moderation records and deletion are managed only through trusted admin tools.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
